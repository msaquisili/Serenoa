{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serenoa",
  "main": "worker.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "mongoose": "./node_modules/mongoose/index.js"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ADMIN_USER": "Ari",
    "FRONTEND_URL": "https://serenoa.pages.dev",
    "NODE_ENV": "production"
  }
}
